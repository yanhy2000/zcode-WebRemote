{
  "name": "zcode-remote",
  "version": "1.0.1",
  "description": "Self-hosted Web Remote Control server & gateway for ZCode",
  "type": "module",
  "main": "dist/index.js",
  "packageManager": "pnpm@10.19.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "zcode",
    "remote-control",
    "websocket",
    "relay",
    "self-hosted"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
